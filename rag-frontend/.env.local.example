# Copy to .env.local for local `npm run dev`.
# Next.js does NOT read the repo-root .env; Docker builds get these as build
# args from compose instead. Values are inlined at build time, so restart the
# dev server after changing them.
NEXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
NEXT_PUBLIC_API_BASE_CHAT=http://localhost:50051/api/v1
