# Keep the build context small and deterministic, and keep local secrets and
# stale build output out of the image. Without this, a local .env.local is
# copied in and can override the build args passed by compose.
node_modules
.next
out
build
.git
.gitignore
.env
.env.*
Dockerfile
.dockerignore
README.md
npm-debug.log*
*.tsbuildinfo
next-env.d.ts
.DS_Store
