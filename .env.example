# Template. cp .env.example .env, then set JWT_SECRET
# (openssl rand -hex 48). Nothing else is needed for a dev run.

# development = email to the log, documents to ./local_data, no AWS/SMTP needed.
# Anything else uses real SMTP and S3.
ENV=development

# DATABASE -- "postgres" is the compose service name.
# On the host instead: DB_HOST=localhost DB_PORT=5433
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=ai_knowledgebase
DB_SSL_MODE=disable
DB_TYPE=postgres

# AUTH -- required, min 32 chars, identical in both services.
# Generate: openssl rand -hex 48
JWT_SECRET=

# URLS -- CORS_ORIGINS is Go only; chats-service allows FRONTEND_BASE_URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000

USER_PORT=8080
CHAT_PORT=50051

# INFERENCE -- self-hosted only. Ollama runs on the host, not in Docker.
# LLM_BASE_URL is required: without it the client falls back to api.openai.com.
# Connection refused? Restart Ollama with OLLAMA_HOST=0.0.0.0:11434
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=gemma4:e4b
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Must equal document_chunks.embedding vector(N). Changing it needs a migration.
EMBEDDING_DIM=1024

# AWS S3 -- only used when ENV is not development.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# RABBITMQ -- BACKEND may be blank; job status lives in training_jobs.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_BACKEND=rpc://

# EMAIL -- unused when ENV=development.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# FRONTEND -- inlined at build time; compose passes these as build args.
# `npm run dev` reads rag-frontend/.env.local instead.
NEXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
NEXT_PUBLIC_API_BASE_CHAT=http://localhost:50051/api/v1
