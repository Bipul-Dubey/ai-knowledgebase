# Template. cp .env.example .env, then set JWT_SECRET
# (openssl rand -hex 48). Nothing else is needed for a dev run.

# development = email to the log, documents to ./local_data, no AWS/SMTP needed.
# Anything else uses real SMTP and S3.
ENV=development

# DATABASE -- "postgres" is the compose service name.
# On the host instead: DB_HOST=localhost DB_PORT=5433
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=ai_knowledgebase
DB_SSL_MODE=disable
DB_TYPE=postgres

# AUTH -- required, min 32 chars, identical in both services.
# Generate: openssl rand -hex 48
JWT_SECRET=

# URLS -- CORS_ORIGINS is Go only; chats-service allows FRONTEND_BASE_URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000

USER_PORT=8080
CHAT_PORT=50051

# INFERENCE -- self-hosted only. Ollama runs on the host, not in Docker.
# LLM_BASE_URL is required: without it the client falls back to api.openai.com.
# Connection refused? Restart Ollama with OLLAMA_HOST=0.0.0.0:11434
# Host-side: set OLLAMA_CONTEXT_LENGTH=8192 and OLLAMA_KEEP_ALIVE=-1 (see README).
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=gemma4:e4b
# gemma4 thinks by default and that time is pure latency here; "none" maps
# onto think=false in Ollama. Blank = the model's default (on).
LLM_REASONING_EFFORT=none
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Must equal document_chunks.embedding vector(N). Changing it needs a migration.
EMBEDDING_DIM=1024
# Texts per /v1/embeddings call during training. Higher = fewer round trips
# and better server-side batching, at more memory per request.
EMBED_BATCH_SIZE=32

# CHUNKING -- changing either invalidates every document's index fingerprint,
# so the next training run re-embeds instead of skipping. 1000 chars was only
# ~150-250 words and routinely split an explanation in half.
CHUNK_SIZE=1500
CHUNK_OVERLAP=250
# Prepend "document > section (page N)" to each chunk before embedding, so a
# chunk from page 40 knows what document it belongs to. chunk_text stays clean.
CONTEXTUAL_CHUNK_HEADER=true
# Drop table-of-contents / index pages at index time: they list every topic and
# explain none, so they match keyword queries while being useless as context.
SKIP_NAVIGATIONAL_CHUNKS=true

# RETRIEVAL -- RETRIEVE_K candidates leave the vector index, the reranker keeps
# TOP_K_RAG. Every query logs its scores; tune the two floors from those.
# Cosine distance: 0 identical, 1 orthogonal, 2 opposite.
RETRIEVE_K=40
# Hybrid retrieval: keyword (BM25) results fused with vector results by
# Reciprocal Rank Fusion, which compares rankings so the two score scales
# never have to be reconciled. false = vector only.
HYBRID_SEARCH=true
KEYWORD_K=20
RRF_K=60
TOP_K_RAG=5
MAX_COSINE_DISTANCE=1.0
# 0.0 = reranker orders results but rejects nothing; tune from logged scores.
# Max chunks from any one document, so a large document cannot crowd out the
# others. With TOP_K_RAG=5 a cap of 2 means up to 3 documents are quoted.
MAX_CHUNKS_PER_DOCUMENT=2
# Blank disables reranking -- chat still works, ranking is just weaker.
# Changing the reranker model needs a rebuild: it is baked in as a build ARG.
RERANK_URL=http://reranker-service:8000

# AWS S3 -- only used when ENV is not development.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# RABBITMQ -- BACKEND may be blank; job status lives in training_jobs.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_BACKEND=rpc://

# EMAIL -- unused when ENV=development.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# FRONTEND -- inlined at build time; compose passes these as build args.
# `npm run dev` reads rag-frontend/.env.local instead.
NEXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
NEXT_PUBLIC_API_BASE_CHAT=http://localhost:50051/api/v1
