# ==========================================================
#  TEMPLATE - copy to .env and fill in the blanks:
#    cp .env.example .env
#    openssl rand -hex 48      -> paste into JWT_SECRET=
#  Nothing else is required for a development run (see ENV below).
# ==========================================================

ENV=development

# ENV above is the ONLY dev-mode switch, and it replaces two backends so the
# stack runs with no AWS account and no mail account:
#   users-service  writes emails to its log instead of sending them
#                  (docker compose logs users-service | grep EMAIL)
#   chats-service  stores documents under ./local_data/ instead of S3
#                  (already gitignored)
# Set ENV to anything else (production, staging) for real SMTP and real S3.
# Only the exact string "development" enables the dev backends.
#
# Optional overrides; both have working defaults, neither needs setting:
# LOCAL_STORAGE_DIR=/app/local_data/documents
# CHAT_PUBLIC_BASE_URL=http://localhost:50051


# ==================== DATABASE ====================
# Compose service name is "postgres" on microservices-network.
# LOCAL: DB_HOST=localhost  DB_PORT=5433   (compose publishes 5432 -> 5433 on the host)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=ai_knowledgebase

# Read by Go (shared/db) only. Required for a managed/remote Postgres.
DB_SSL_MODE=disable

# Read by Python (chats-service config) only. Informational.
DB_TYPE=postgres


# ==================== AUTH ====================
# Shared HMAC signing key. REQUIRED - both services refuse to start without it
# (minimum 32 characters), and the value must be byte-identical on both or
# tokens issued by users-service are rejected by chats-service with a 401.
#
# Left blank on purpose: a secret committed to a template would be shared by
# every clone, so anyone could forge tokens for any organization.
# Generate one with:
#   openssl rand -hex 48
JWT_SECRET=


# ==================== CORS / URLS ====================
# CORS_ORIGINS: read by Go (shared/middleware/cors.go). Comma-separated, exact-match.
# NOTE: chats-service ignores this and allows only FRONTEND_BASE_URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Used to build verification / invite / reset links in emails, and as the
# single allowed CORS origin for chats-service. No trailing slash.
FRONTEND_BASE_URL=http://localhost:3000


# ==================== PORTS ====================
USER_PORT=8080
CHAT_PORT=50051


# ==================== INFERENCE (self-hosted only) ====================
# Embeddings and generation both run on open-weight models served locally.
# There is no hosted provider and no provider API key anywhere in this stack.
#
# Ollama runs on the HOST, never in a container: Docker Desktop on macOS gives
# containers no Metal access, so a containerised Ollama would fall back to CPU.
#   from a container:  http://host.docker.internal:11434/v1
#   from the host:     http://localhost:11434/v1
# Connection refused? Ollama binds loopback by default -- restart it with
# OLLAMA_HOST=0.0.0.0:11434
#
# REQUIRED. chats-service refuses to start without it, because an
# OpenAI-compatible client given no base URL falls back to api.openai.com.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=gemma4:e4b
EMBEDDING_MODEL=qwen3-embedding:0.6b

# Must equal document_chunks.embedding's declared vector(N). Checked on every
# embedding call. Changing it means resizing that column and re-embedding every
# document -- not an additive change, so it needs a one-off SQL script.
#   1024 = qwen3-embedding:0.6b
#    768 = embeddinggemma-2
EMBEDDING_DIM=1024

# Optional. Ollama wants a non-empty bearer token and ignores its value, so the
# default ("ollama") is fine. Set it only for a self-hosted gateway such as
# vLLM or LiteLLM that actually checks it.
# LLM_API_KEY=


# ==================== AWS S3 ====================
# Required for document upload / download / training.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=


# ==================== RABBITMQ (Celery) ====================
# LOCAL: RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Celery result backend. "rpc://" reuses RabbitMQ — no extra service needed.
# Can safely be left blank: job status is tracked in the training_jobs table,
# and no caller ever reads a task result.
RABBITMQ_BACKEND=rpc://


# ==================== EMAIL (SMTP) ====================
# Optional for local dev. If blank, the Go email sender returns
# "missing SMTP configuration". Signup still succeeds (mail is sent in a
# goroutine) and the verification token comes back in the signup response.
# Gmail requires an App Password, not your account password.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587


# ==================== FRONTEND ====================
# These are browser-side URLs, so localhost is correct (the browser is on the host).
NEXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
NEXT_PUBLIC_API_BASE_CHAT=http://localhost:50051/api/v1


